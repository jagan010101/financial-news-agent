# ── Database ──────────────────────────────────────────────────────────────────
DATABASE_URL=postgresql+psycopg://finrag:finrag@localhost:5432/finrag

# ── Normal tier: Ollama (local, free) — every routine score + chat turn ───────
# Run `ollama serve` first; pull the model with `ollama pull qwen2.5:7b-instruct`
OLLAMA_HOST=http://localhost:11434
OLLAMA_MODEL=qwen2.5:7b-instruct

# ── Premium tier: Groq -> Google — ONLY report-writing summaries + dispute ────
# resolution (a score the deterministic validator flagged/rejected). Never
# used silently for routine scoring or chat. Leave both unset to disable.
# Groq free tier — https://console.groq.com
GROQ_API_KEY=gsk_...
GROQ_MODEL=llama-3.3-70b-versatile
# Google AI Studio free tier — https://aistudio.google.com
GOOGLE_API_KEY=...
GOOGLE_MODEL=gemini-2.0-flash

# ── Local models (downloaded on first run, no API key needed) ─────────────────
EMBED_MODEL=Qwen/Qwen3-Embedding-0.6B
RERANK_MODEL=Qwen/Qwen3-Reranker-0.6B
SENTIMENT_MODEL=ProsusAI/finbert

# ── Scoring thresholds ─────────────────────────────────────────────────────────
SCORE_THRESHOLD=5.0         # composite > this -> included in digest
IMMEDIATE_THRESHOLD=8.0     # composite > this -> flagged as high-priority

# ── Email delivery (Gmail app password recommended) ───────────────────────────
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=you@gmail.com
SMTP_PASSWORD=xxxxxxxxxxxxxxxx
EMAIL_TO=recipient@example.com
